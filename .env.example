# Optional: set a Formspree endpoint (for example, https://formspree.io/f/your-form-id)
# When configured, the inquiry form POSTs JSON to this endpoint.
VITE_FORMSPREE_ENDPOINT=

# Used by the mailto fallback when no form endpoint is configured.
VITE_CONTACT_EMAIL=hello@grttechnology.com

# Digits only, with country code. Example: 919876543210
# Leave blank until the real WhatsApp business number is available.
VITE_WHATSAPP_NUMBER=
